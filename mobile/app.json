{
  "expo": {
    "name": "Fitness 7",
    "slug": "fitness-7-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitness7",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060A",
    "primaryColor": "#C8FF1E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.fitness7gym.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "in.fitness7gym.app",
      "adaptiveIcon": {
        "backgroundColor": "#05060A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05060A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitness 7 uses your photos so you can log a meal from a picture.",
          "cameraPermission": "Fitness 7 uses the camera so you can snap your plate and log a meal.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
