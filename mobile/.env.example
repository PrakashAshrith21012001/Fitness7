# Base URL of the deployed website; the app calls its /api routes (Ask F7, food logging, account delete).
EXPO_PUBLIC_API_URL=https://fitness7gym.in

# Supabase — leave both blank and the app runs in LOCAL MODE (session on the phone, nothing synced).
# Supabase dashboard → Settings → API keys. The publishable key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (legacy projects: EXPO_PUBLIC_SUPABASE_ANON_KEY= works too)

# Google sign-in — optional. Without these the Google button says it's not set up yet.
# See supabase/README.md §3 for where each id comes from.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
